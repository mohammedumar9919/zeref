{
  "name": "zeref",
  "private": true,
  "packageManager": "npm@10",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json && npm run build -w @zeref/web",
    "lint": "tsc -b tsconfig.build.json --pretty false --noEmit",
    "dev": "npm run dev:stack",
    "dev:worker": "node scripts/worker.mjs",
    "dev:stack": "node scripts/dev-stack.mjs",
    "dev:clean": "node scripts/dev-clean.mjs",
    "pipeline:run": "node scripts/run-pipeline.mjs",
    "verify:phase-0": "node scripts/verify-phase-0.mjs",
    "verify:phase-1": "node scripts/verify-phase-1.mjs",
    "verify:phase-2": "node scripts/verify-phase-2.mjs",
    "verify:phase-3": "node scripts/verify-phase-3.mjs",
    "verify:phase-4": "node scripts/verify-phase-4.mjs",
    "verify:phase-5": "node scripts/verify-phase-5.mjs",
    "verify:phase-5.1": "node scripts/verify-phase-5.1.mjs",
    "verify:phase-6.1": "node scripts/verify-phase-6.1.mjs",
    "verify:phase-6": "node scripts/verify-phase-6.mjs",
    "verify:phase-7": "node scripts/verify-phase-7.mjs",
    "verify:phase-8": "node scripts/verify-phase-8.mjs",
    "verify:phase-9": "node scripts/verify-phase-9.mjs",
    "verify:hotfix-p8": "node scripts/verify-hotfix-p8.mjs",
    "verify:phase-10": "node scripts/verify-phase-10.mjs",
    "verify:phase-10.5": "node scripts/verify-phase-10.5.mjs",
    "verify:phase-11": "node scripts/verify-phase-11.mjs",
    "verify:phase-12": "node scripts/verify-phase-12.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}

