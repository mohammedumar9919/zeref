# Zeref — local development environment variables (NO SECRETS)
# Copy to .env and adjust for your machine.

# --- Postgres (docker compose / worker) ---
POSTGRES_DB=zeref
POSTGRES_USER=zeref
POSTGRES_PASSWORD=zeref
POSTGRES_PORT=5432
DATABASE_URL=postgresql://zeref:zeref@localhost:5432/zeref

# --- Voice / Jarvis (server-side only — also copy to apps/web/.env.local for Next dev) ---
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# OPENAI_API_KEY=

# --- Fixture / mock flags (set to 1 for offline CI and layout smoke) ---
# ZEREF_BFF_FIXTURE=1          # In-memory BFF slices; no Postgres required
# ZEREF_JOB_ENQUEUE_MOCK=1      # Mock POST /api/v1/jobs/enqueue (no pg-boss)
# ZEREF_LLM_MOCK=1              # Fixture LLM responses (voice/JARVIS)
# ZEREF_TTS_MOCK=1              # Fixture TTS audio blobs
# ZEREF_WHISPER_MOCK=1          # Fixture STT transcript (skip whisper sidecar)
# ZEREF_MEMORY_MOCK=1           # In-memory brain/memory fixtures (Phase 7)

# --- Phase product gates (enable real UI slices in dev / verify) ---
# ZEREF_PHASE51_UI=1            # Phase 5.1 cockpit HUD UI enforcement
# ZEREF_PHASE6_VOICE=1          # Phase 6 voice UI enforcement
# ZEREF_PHASE61_UI=1            # Phase 6.1 HUD UI enforcement
# ZEREF_PHASE7_BRAIN=1          # Phase 7 brain/memory UI enforcement
# ZEREF_PHASE8_PRODUCT=1        # Phase 8 studio + calendar product UI
# ZEREF_PHASE9_RESEARCH=1       # Phase 9 research hub UI + enqueue schema
# ZEREF_PHASE10_OPS=1           # Phase 10 ops worker-health Playwright gate

# --- Live stack / ops honesty ---
# ZEREF_WORKER_AVAILABLE=1      # Set by dev:stack on web child (C111); gates outbox drain
# ZEREF_PLAYWRIGHT_REUSE=1      # Reuse running Next dev server in Playwright

# --- Optional sidecar / tooling ---
# WHISPER_SIDECAR_URL=http://127.0.0.1:8765
# WHISPER_MODEL=base
# WHISPER_DEVICE=cpu
# SKIP_DB_TESTS=1               # Skip Postgres integration tests in @zeref/web
