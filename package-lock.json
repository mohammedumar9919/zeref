{
  "name": "zeref",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "zeref",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "devDependencies": {
        "typescript": "^5.9.2"
      },
      "engines": {
        "node": ">=22"
      }
    },
    "apps/api": {
      "name": "@zeref/api",
      "version": "0.0.0",
      "dependencies": {
        "@zeref/contracts": "0.0.0",
        "@zeref/domain": "0.0.0"
      }
    },
    "apps/web": {
      "name": "@zeref/web",
      "version": "0.0.0",
      "dependencies": {
        "@zeref/contracts": "0.0.0"
      }
    },
    "apps/worker": {
      "name": "@zeref/worker",
      "version": "0.0.0",
      "dependencies": {
        "@zeref/domain": "0.0.0"
      }
    },
    "node_modules/@zeref/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@zeref/contracts": {
      "resolved": "packages/contracts",
      "link": true
    },
    "node_modules/@zeref/db": {
      "resolved": "packages/db",
      "link": true
    },
    "node_modules/@zeref/domain": {
      "resolved": "packages/domain",
      "link": true
    },
    "node_modules/@zeref/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/@zeref/worker": {
      "resolved": "apps/worker",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz",
      "integrity": "sha512-jl1vZzPDinLr9eUt3J/t7V6FgNEw9QjvBPdysz9KfQDD41fQrC2Y4vKQdiaUpFT4bXlb1RHhLpp8wtm6M5TgSw==",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/contracts": {
      "name": "@zeref/contracts",
      "version": "0.0.0"
    },
    "packages/db": {
      "name": "@zeref/db",
      "version": "0.0.0"
    },
    "packages/domain": {
      "name": "@zeref/domain",
      "version": "0.0.0",
      "dependencies": {
        "@zeref/contracts": "0.0.0"
      }
    }
  }
}
